class Student {

    private int studentId;
    private String name;
    private int age;
    private String department;
    private double gpa;

    static String universityName = "University of Somalia";

    public Student(int studentId, String name, int age,
                   String department, double gpa) {

        this.studentId = studentId;
        this.name = name;
        this.department = department;

        if (age >= 18 && age <= 60) {
            this.age = age;
        } else {
            this.age = 18;
        }

        if (gpa >= 0 && gpa <= 4.0) {
            this.gpa = gpa;
        } else {
            this.gpa = 0.0;
        }
    }

    public void displayInfo() {
        System.out.println("Student ID: " + studentId);
        System.out.println("Name: " + name);
        System.out.println("Age: " + age);
        System.out.println("Department: " + department);
        System.out.println("GPA: " + gpa);
        System.out.println("University: " + universityName);
        System.out.println("Status: " + (hasPassed() ? "Passed" : "Failed"));
    }

    public boolean hasPassed() {
        return gpa >= 2.0;
    }
}

public class Main {

    public static void main(String[] args) {

        Student student1 =
                new Student(101, "Ali", 20, "Computer Science", 3.5);

        Student student2 =
                new Student(102, "Ahmed", 21, "Information Technology", 2.8);

        Student student3 =
                new Student(103, "Mohamed", 19, "Business", 1.7);

        Student student4 =
                new Student(104, "Hassan", 22, "Computer Science", 3.9);

        student1.displayInfo();
        student2.displayInfo();
        student3.displayInfo();
        student4.displayInfo();
    }
}
